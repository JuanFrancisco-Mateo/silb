{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whispr Open",
  "version": "0.1.0",
  "identifier": "com.whispr.open",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      },
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Whispr Open",
        "width": 1180,
        "height": 800,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local open-source voice dictation",
    "longDescription": "A private desktop dictation workspace powered by local Whisper.cpp WASM transcription.",
    "copyright": "Whispr Open contributors",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
